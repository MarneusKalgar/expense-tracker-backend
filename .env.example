#Env
PORT=3000
NODE_ENV=development

# Server
SERVER_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# BCrypt
BCRYPT_SALT_ROUNDS=10

# JWT (generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET=your-64-char-secret-here
JWT_REFRESH_SECRET=your-64-char-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_CLOUD_USER=default
REDIS_CLOUD_PASSWORD=your-redis-password
REDIS_CLOUD_HOST=your-redis-host.redislabs.com
REDIS_CLOUD_PORT=12345
REDIS_APP_KEY_TTL=86400

# Logging
APP_LOG_LEVEL=info

